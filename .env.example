# Copy to .env.local for local work; set the same two variables in your hosting dashboard for production.
# Replace with the URL ending in /exec from Apps Script > Deploy > New deployment > Web app.
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
# Replace with a long random string matching the Apps Script SHARED_SECRET property.
GOOGLE_SCRIPT_SECRET=replace-with-a-long-random-secret
